    "pdf:generate": "node scripts/generate-itinerary.mjs",
    "pdf:check": "node scripts/check-itinerary.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "@netlify/functions": "^6.0.0",
    "@netlify/identity": "^2.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "drizzle-orm": "0.45.2",
    "html2canvas": "^1.4.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.2",
